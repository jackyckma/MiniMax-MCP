MINIMAX_API_KEY=PUT_YOUR_KEY_HERE
#optional base path for output files (stdio / local resource mode only)
MINIMAX_MCP_BASE_PATH=~/Desktop
# Global: https://api.minimax.io  Mainland: https://api.minimaxi.com
# The key and host region must match.
MINIMAX_API_HOST=https://api.minimax.io
#optional resource mode[url, local], default is url. Ignored in HTTP mode (forced to url).
# MINIMAX_API_RESOURCE_MODE=url

# Remote Streamable HTTP (Zeabur). Leave unset for local stdio.
# MCP_TRANSPORT=http
# MCP_SERVER_TOKEN=replace-with-openssl-rand-hex-32
# PORT=8080
# MINIMAX_MCP_ALLOWED_TOOLS=text_to_audio,list_voices,voice_clone,voice_design,text_to_image,generate_video,query_video_generation
# MINIMAX_DEFAULT_SPEECH_MODEL=speech-2.8-hd
# MINIMAX_DEFAULT_T2V_MODEL=MiniMax-Hailuo-2.3
# MINIMAX_DEFAULT_T2I_MODEL=image-01